#!/bin/sh

# Load code on demand (interactive) instead of preloading every module of every
# dependency (embedded): most dependency code is never called, and preloading it
# costs ~250 MB of resident memory. IntellectualClub.Application still loads all
# application modules at boot (see docs/release-builds.md).
# Set RELEASE_MODE=embedded in the environment to opt out.
export RELEASE_MODE="${RELEASE_MODE:-interactive}"
