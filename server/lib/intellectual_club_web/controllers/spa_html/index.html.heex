<div
  id="spa-root"
  data-current-user-id={if @current_user, do: @current_user.id, else: ""}
  data-current-user-username={if @current_user, do: @current_user.username, else: ""}
  data-current-user-is-admin={if @current_user, do: to_string(@current_user.is_admin), else: ""}
  data-current-user-preferred-locale={
    if @current_user, do: @current_user.preferred_locale || "", else: ""
  }
  data-current-user-preferred-theme={
    if @current_user, do: @current_user.preferred_theme || "system", else: "system"
  }
  data-bootstrap-stage="runtime"
>
  <div id="spa-bootstrap-shell" class="spa-bootstrap-shell">
    <header class="spa-bootstrap-header" aria-hidden="true">
      <span class="spa-bootstrap-brand">
        <img src={~p"/favicon.png"} alt="" />
        <span>Intellectual Club</span>
      </span>
      <span class="spa-bootstrap-header-spacer"></span>
    </header>

    <section
      id="spa-bootstrap-status"
      class="spa-bootstrap-status"
      role="status"
      aria-live="polite"
      data-message-preparing={gettext("Preparing the interface…")}
      data-message-offline={gettext("Waiting for a connection…")}
      data-message-retrying={gettext("Restoring the connection…")}
      data-attempt-label={gettext("Attempt")}
      hidden
    >
      <div class="spa-bootstrap-status-copy">
        <span class="spa-bootstrap-status-dot" aria-hidden="true"></span>
        <span data-bootstrap-message>{gettext("Preparing the interface…")}</span>
      </div>
      <div
        class="spa-bootstrap-steps"
        role="progressbar"
        aria-label={gettext("Application startup progress")}
        aria-valuemin="1"
        aria-valuemax="3"
        aria-valuenow="1"
      >
        <span class="spa-bootstrap-step is-active" data-bootstrap-step="runtime">
          {gettext("Interface")}
        </span>
        <span class="spa-bootstrap-step" data-bootstrap-step="route">
          {gettext("Section")}
        </span>
        <span class="spa-bootstrap-step" data-bootstrap-step="data">{gettext("Data")}</span>
      </div>
    </section>

    <main class="spa-bootstrap-main" aria-hidden="true">
      <aside class="spa-bootstrap-panel spa-bootstrap-sidebar"></aside>
      <section class="spa-bootstrap-panel spa-bootstrap-content">
        <div class="spa-bootstrap-toolbar"></div>
        <div class="spa-bootstrap-content-body"></div>
      </section>
    </main>
  </div>
</div>
