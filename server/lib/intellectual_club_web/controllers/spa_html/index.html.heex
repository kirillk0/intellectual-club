<div
  id="spa-root"
  data-current-user-id={if @current_user, do: @current_user.id, else: ""}
  data-current-user-username={if @current_user, do: @current_user.username, else: ""}
  data-current-user-is-admin={if @current_user, do: to_string(@current_user.is_admin), else: ""}
  data-current-user-preferred-locale={
    if @current_user, do: @current_user.preferred_locale || "", else: ""
  }
  data-current-user-preferred-theme={
    if @current_user, do: @current_user.preferred_theme || "system", else: "system"
  }
>
  <div class="spa-boot">
    <div class="spa-boot__content">
      <p class="spa-boot__status" role="status" aria-live="polite">{gettext("Loading…")}</p>
      <button
        class="spa-boot__reload"
        type="button"
        onclick="
          this.disabled = true;
          this.setAttribute('aria-busy', 'true');
          this.classList.add('spa-boot__reload--pending');
          window.requestAnimationFrame(function () {
            window.requestAnimationFrame(function () { window.location.reload(); });
          });
        "
      >
        {gettext("Reload")}
      </button>
    </div>
  </div>
</div>
