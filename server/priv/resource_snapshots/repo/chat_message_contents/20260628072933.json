  "custom_statements": [
    {
      "code?": false,
      "down": "DROP FUNCTION IF EXISTS set_chat_message_content_item_type()",
      "global?": false,
      "name": "chat_message_contents_set_item_type_function",
      "up": "CREATE OR REPLACE FUNCTION set_chat_message_content_item_type()\nRETURNS trigger AS $$\nBEGIN\n  SELECT type\n  INTO NEW.item_type\n  FROM chat_message_items\n  WHERE id = NEW.chat_message_item_id;\n\n  IF NEW.item_type IS NULL THEN\n    RAISE EXCEPTION 'Cannot resolve item type for chat message item %', NEW.chat_message_item_id;\n  END IF;\n\n  RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql\n"
    },
    {
      "code?": false,
      "down": "DROP TRIGGER IF EXISTS chat_message_contents_set_item_type ON chat_message_contents",
      "global?": false,
      "name": "chat_message_contents_set_item_type_trigger",
      "up": "CREATE TRIGGER chat_message_contents_set_item_type\nBEFORE INSERT OR UPDATE OF chat_message_item_id, item_type\nON chat_message_contents\nFOR EACH ROW\nEXECUTE FUNCTION set_chat_message_content_item_type()\n"
    },
    {
      "code?": false,
      "down": "DROP FUNCTION IF EXISTS sync_chat_message_content_item_type()",
      "global?": false,
      "name": "chat_message_contents_sync_item_type_function",
      "up": "CREATE OR REPLACE FUNCTION sync_chat_message_content_item_type()\nRETURNS trigger AS $$\nBEGIN\n  UPDATE chat_message_contents\n  SET item_type = NEW.type\n  WHERE chat_message_item_id = NEW.id\n    AND item_type IS DISTINCT FROM NEW.type;\n\n  RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql\n"
    },
    {
      "code?": false,
      "down": "DROP TRIGGER IF EXISTS chat_message_contents_sync_item_type ON chat_message_items",
      "global?": false,
      "name": "chat_message_contents_sync_item_type_trigger",
      "up": "CREATE TRIGGER chat_message_contents_sync_item_type\nAFTER UPDATE OF type\nON chat_message_items\nFOR EACH ROW\nWHEN (OLD.type IS DISTINCT FROM NEW.type)\nEXECUTE FUNCTION sync_chat_message_content_item_type()\n"
    },
    {
      "code?": false,
      "down": "DROP INDEX IF EXISTS chat_message_contents_searchable_content_text_trgm_index",
      "global?": false,
      "name": "chat_message_contents_searchable_content_text_trgm_index",
      "up": "CREATE INDEX IF NOT EXISTS chat_message_contents_searchable_content_text_trgm_index ON chat_message_contents USING gin (content_text gin_trgm_ops) WHERE kind = 'text' AND item_type IN ('input', 'handoff_request', 'handoff_context', 'handoff_history', 'handoff_message', 'answer', 'handoff_summary')"
    }
  ],
