#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: bin/build-macos-dmg [--app <path-to-app>]... [--binary <path>]...
                           --volume-name <name> --output <path-to-dmg>

Creates a compressed macOS disk image containing one or more application
bundles or terminal executables, an Applications shortcut, and first-launch
Gatekeeper instructions.
EOF
}

APP_PATHS=()
BINARY_PATHS=()
OUTPUT_PATH=""
VOLUME_NAME=""
README_NAME="First Launch.txt"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --app)
      APP_PATHS+=("${2:-}")
      shift 2
      ;;
    --binary)
      BINARY_PATHS+=("${2:-}")
      shift 2
      ;;
    --volume-name)
      VOLUME_NAME="${2:-}"
      shift 2
      ;;
    --output)
      OUTPUT_PATH="${2:-}"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "DMG images must be built on macOS" >&2
  exit 1
fi

if [[ -z "${OUTPUT_PATH}" || -z "${VOLUME_NAME}" ]]; then
  echo "--volume-name and --output are required" >&2
  usage >&2
  exit 2
fi

if [[ "${#APP_PATHS[@]}" -eq 0 && "${#BINARY_PATHS[@]}" -eq 0 ]]; then
  echo "At least one --app or --binary is required" >&2
  usage >&2
  exit 2
fi

if [[ "${OUTPUT_PATH}" != /* ]]; then
  OUTPUT_PATH="${PWD}/${OUTPUT_PATH}"
fi

if [[ "${OUTPUT_PATH}" != *.dmg ]]; then
  echo "Output path must end with .dmg" >&2
  exit 1
fi

PAYLOAD_PATHS=()
PAYLOAD_NAMES=()
APP_NAMES=()
BINARY_NAMES=()

add_payload() {
  local path="$1"
  local kind="$2"
  local name
  local existing

  if [[ "${path}" != /* ]]; then
    path="${PWD}/${path}"
  fi
  name="$(basename -- "${path}")"

  if [[ "${kind}" == "app" ]]; then
    if [[ ! -d "${path}" || "${name}" != *.app ]]; then
      echo "Application bundle not found: ${path}" >&2
      exit 1
    fi
  elif [[ ! -f "${path}" || ! -x "${path}" ]]; then
    echo "Executable binary not found: ${path}" >&2
    exit 1
  fi

  if [[ "${name}" == "Applications" || "${name}" == "${README_NAME}" ]]; then
    echo "Payload name is reserved: ${name}" >&2
    exit 1
  fi

  if [[ "${#PAYLOAD_NAMES[@]}" -gt 0 ]]; then
    for existing in "${PAYLOAD_NAMES[@]}"; do
      if [[ "${existing}" == "${name}" ]]; then
        echo "Duplicate payload name: ${name}" >&2
        exit 1
      fi
    done
  fi

  PAYLOAD_PATHS+=("${path}")
  PAYLOAD_NAMES+=("${name}")
  if [[ "${kind}" == "app" ]]; then
    APP_NAMES+=("${name}")
  else
    BINARY_NAMES+=("${name}")
  fi
}

if [[ "${#APP_PATHS[@]}" -gt 0 ]]; then
  for app_path in "${APP_PATHS[@]}"; do
    add_payload "${app_path}" app
  done
fi

if [[ "${#BINARY_PATHS[@]}" -gt 0 ]]; then
  for binary_path in "${BINARY_PATHS[@]}"; do
    add_payload "${binary_path}" binary
  done
fi

OUTPUT_DIR="$(dirname -- "${OUTPUT_PATH}")"
mkdir -p "${OUTPUT_DIR}"

WORK_DIR="$(mktemp -d "${OUTPUT_DIR}/.intellectual-club-dmg.XXXXXX")"
SOURCE_DIR="${WORK_DIR}/source"
RW_DMG="${WORK_DIR}/installer-rw.dmg"
COMPRESSED_DMG="${WORK_DIR}/installer.dmg"
DEVICE=""

cleanup() {
  if [[ -n "${DEVICE}" ]]; then
    hdiutil detach "${DEVICE}" >/dev/null 2>&1 || true
  fi
  rm -rf "${WORK_DIR}"
}
trap cleanup EXIT

if [[ -e "/Volumes/${VOLUME_NAME}" ]]; then
  echo "A volume named ${VOLUME_NAME} is already mounted" >&2
  exit 1
fi

mkdir -p "${SOURCE_DIR}"
for payload_index in "${!PAYLOAD_PATHS[@]}"; do
  ditto \
    "${PAYLOAD_PATHS[${payload_index}]}" \
    "${SOURCE_DIR}/${PAYLOAD_NAMES[${payload_index}]}"
done
ln -s /Applications "${SOURCE_DIR}/Applications"

{
  cat <<'EOF'
INSTALLATION

Drag the application bundles listed below onto the Applications shortcut:
EOF
  if [[ "${#APP_NAMES[@]}" -gt 0 ]]; then
    for app_name in "${APP_NAMES[@]}"; do
      printf '  - %s\n' "${app_name}"
    done
  fi

  if [[ "${#BINARY_NAMES[@]}" -gt 0 ]]; then
    cat <<'EOF'

Terminal tools included in this image:
EOF
    for binary_name in "${BINARY_NAMES[@]}"; do
      printf '  - %s\n' "${binary_name}"
    done
    cat <<'EOF'

Copy terminal tools to a directory on PATH, such as /usr/local/bin, or run
them directly from this disk image.
EOF
  fi

  cat <<'EOF'

This build is signed but not notarized. If macOS blocks the first launch,
open System Settings → Privacy & Security, find the application warning, click
Open Anyway, and confirm the launch. Only do this for a disk image downloaded
from the official project page.
EOF
} >"${SOURCE_DIR}/${README_NAME}"

hdiutil create \
  -quiet \
  -srcfolder "${SOURCE_DIR}" \
  -volname "${VOLUME_NAME}" \
  -fs HFS+ \
  -format UDRW \
  "${RW_DMG}"

attach_output="$({
  hdiutil attach \
    -readwrite \
    -noverify \
    -noautoopen \
    "${RW_DMG}"
})"
DEVICE="$(awk 'NF >= 3 { device = $1 } END { print device }' <<<"${attach_output}")"

if [[ -z "${DEVICE}" ]]; then
  echo "Could not determine the mounted disk image device" >&2
  exit 1
fi

finder_ready="false"
for attempt in {1..20}; do
  finder_ready="$(osascript - "${VOLUME_NAME}" <<'APPLESCRIPT'
on run arguments
  set volumeName to item 1 of arguments
  tell application "Finder" to return exists disk volumeName
end run
APPLESCRIPT
)"
  if [[ "${finder_ready}" == "true" ]]; then
    break
  fi
  sleep 0.5
done

if [[ "${finder_ready}" != "true" ]]; then
  echo "Finder did not discover the mounted ${VOLUME_NAME} volume" >&2
  exit 1
fi

osascript - \
  "${VOLUME_NAME}" \
  "${README_NAME}" \
  "${PAYLOAD_NAMES[@]}" <<'APPLESCRIPT'
on run arguments
  set volumeName to item 1 of arguments
  set readmeName to item 2 of arguments
  set itemNames to items 3 thru (count arguments) of arguments
  set displayNames to itemNames & {"Applications", readmeName}

  tell application "Finder"
    set targetDisk to disk volumeName
    tell targetDisk
      open
      set current view of container window to icon view
      set toolbar visible of container window to false
      set statusbar visible of container window to false
      set pathbar visible of container window to false
      set bounds of container window to {180, 140, 980, 660}

      set viewOptions to icon view options of container window
      set arrangement of viewOptions to not arranged
      set icon size of viewOptions to 112
      set text size of viewOptions to 14
      set background color of viewOptions to {60138, 61937, 65535}

      repeat with itemIndex from 1 to count displayNames
        set columnIndex to (itemIndex - 1) mod 3
        set rowIndex to (itemIndex - 1) div 3
        set itemName to item itemIndex of displayNames
        set position of item itemName of container window to ¬
          {170 + (columnIndex * 260), 170 + (rowIndex * 180)}
      end repeat

      update without registering applications
      delay 2
      close
    end tell
  end tell
end run
APPLESCRIPT

sync
for attempt in 1 2 3; do
  if hdiutil detach "${DEVICE}" >/dev/null; then
    DEVICE=""
    break
  fi
  if [[ "${attempt}" -eq 3 ]]; then
    echo "Could not detach ${DEVICE}" >&2
    exit 1
  fi
  sleep 2
done

hdiutil convert \
  -quiet \
  "${RW_DMG}" \
  -format UDZO \
  -imagekey zlib-level=9 \
  -o "${COMPRESSED_DMG}"
hdiutil verify "${COMPRESSED_DMG}" >/dev/null

rm -f "${OUTPUT_PATH}"
mv "${COMPRESSED_DMG}" "${OUTPUT_PATH}"

printf 'Built macOS disk image at %s\n' "${OUTPUT_PATH}"
